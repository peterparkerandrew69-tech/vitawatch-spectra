# VitaWatch Spectra — Backend Environment Configuration Example
# Copy to .env for local development or set in deployment environment

PORT=5000
FLASK_ENV=development
APP_MODE=demo

# Application Secrets (Must be set to strong cryptographically secure values in production)
SECRET_KEY=vitawatch-spectra-dev-secret-key-9f8a2b4c6e-prod-replace
JWT_SECRET_KEY=vitawatch-jwt-secret-key-1a3b5c7d9e-prod-replace
JWT_EXPIRES_HOURS=24

# Database Connection (Defaults to SQLite for local development; use PostgreSQL for production)
# SQLite: sqlite:///vitawatch_spectra.db
# PostgreSQL: postgresql://username:password@localhost:5432/vitawatch_spectra
DATABASE_URL=sqlite:///vitawatch_spectra.db

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Device & Gateway Ingestion Security Key
DEVICE_INGEST_KEY=esp32-spectra-gateway-key-2026

# Notification Providers (Optional: when unset, notifications record honest status 'not_configured')
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
