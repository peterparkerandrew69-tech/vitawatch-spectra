{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask Backend (Port 5000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1",
        "PORT": "5000"
      },
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Next.js Frontend (Port 3000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Run Backend Test Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["backend/tests/test_api.py"],
      "console": "integratedTerminal"
    },
    {
      "name": "Simulate ESP32 Telemetry (10 frames)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/simulate_esp32.py",
      "args": ["10"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend (Ports 5000 & 3000)",
      "configurations": [
        "Flask Backend (Port 5000)",
        "Next.js Frontend (Port 3000)"
      ],
      "stopAll": true
    }
  ]
}
