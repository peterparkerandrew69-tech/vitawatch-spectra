{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install All Dependencies (Python & Node)",
      "type": "shell",
      "command": "cmd /c install_dependencies.bat",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    },
    {
      "label": "Start Flask Backend",
      "type": "shell",
      "command": "py app.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Next.js Frontend",
      "type": "shell",
      "command": "npm --prefix frontend run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Full-Stack Application",
      "dependsOn": [
        "Start Flask Backend",
        "Start Next.js Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Backend Test Suite",
      "type": "shell",
      "command": "py -m unittest backend\\tests\\test_api.py",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Simulate ESP32 Ingestion (10 frames)",
      "type": "shell",
      "command": "py scripts/simulate_esp32.py 10",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
